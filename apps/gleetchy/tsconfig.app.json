{
	"$schema": "https://json.schemastore.org/tsconfig",
	"include": ["src"],
	"extends": "code-config/tsconfig.browser.json",
	"compilerOptions": {
		"composite": true,
		"emitDeclarationOnly": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": { "~/*": ["./src/*"] },
		"sourceMap": true,
		"types": [
			"@total-typescript/ts-reset",
			"vite/client",
			"audioworklet",
			"webaudioapi",
			"vitest/importMeta"
		]
	}
}
