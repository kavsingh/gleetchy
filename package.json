{
	"name": "gleetchy-mono",
	"version": "1.0.0",
	"private": true,
	"description": "looping business",
	"license": "ISC",
	"author": "Kav Singh <flakisms@gmail.com> (https://github.com/kavsingh)",
	"repository": {
		"type": "git",
		"url": "https://github.com/kavsingh/gleetchy.git"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"oxfmt": "0.65.0",
			"oxlint": "1.80.0"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "nx dev gleetchy --outputStyle stream",
		"build": "nx build gleetchy",
		"test": "nx run-many -t test --outputStyle stream",
		"lint": "nx run-many -t lint --outputStyle stream",
		"clean:nx": "rimraf ./**/.nx --glob",
		"clean:modules": "rimraf ./**/node_modules --glob",
		"clean:types": "rimraf ./**/*.tsbuildinfo --glob"
	},
	"devDependencies": {
		"@typescript/native-preview": "npm:typescript@7.0.2",
		"code-config": "workspace:*",
		"concurrently": "10.0.5",
		"lefthook": "2.1.12",
		"nx": "23.1.2",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "7.0.2001",
		"rimraf": "6.1.3",
		"typescript": "npm:@typescript/typescript6@6.0.2"
	},
	"packageManager": "bun@1.4.0",
	"trustedDependencies": [
		"lefthook"
	]
}
